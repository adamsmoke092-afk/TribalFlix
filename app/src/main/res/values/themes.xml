<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch/window theme only — all UI is Compose (TribalFlixTheme).
         Platform dark base; Theme.Material3.* does not exist as a platform
         XML resource, so it must not be used here. -->
    <style name="Theme.TribalFlix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
        <item name="android:statusBarColor">@android:color/background_dark</item>
        <item name="android:navigationBarColor">@android:color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
